# 슬랙 봇 토큰 (xoxb-... 형식). 채널에 봇을 초대해야 함.
SLACK_BOT_TOKEN=xoxb-your-token-here

# 대상 채널 ID (기본: #카탈로그n세일운영-수정요청)
CHANNEL_ID=C02CT82KYP8

# 서버 포트
PORT=3000

# 같은 기간 재조회 시 슬랙 API 호출을 건너뛰는 캐시 유효시간(초). 기본 60. 0 이면 매번 새로 읽음.
CACHE_TTL_SEC=60

# ---------- 접근 제어: 구글 로그인 + 이메일 허용목록 ----------
# 아래 3개(GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET)가 모두 채워지면 로그인 기능이 켜진다.
# 하나라도 비면 로컬(127.0.0.1) 접속만 열리고 외부 접근은 차단된다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 세션 쿠키 서명용 임의의 긴 문자열 (32자 이상 권장)
SESSION_SECRET=

# 열람 허용목록. 사람 추가/삭제는 이 두 값만 수정하면 된다(코드 수정 불필요).
# 개별 이메일(콤마 구분):
ALLOWED_EMAILS=geonyong.park@musinsa.com
# 도메인 전체 허용(콤마 구분, 선택). 예: musinsa.com — 채우면 그 도메인 전원이 열람 가능해진다.
ALLOWED_DOMAINS=

# 배포 주소. 구글 콜백 URL 을 이 값으로 만든다. 예: https://xxx.onrender.com
# 로컬에서는 비워두면 요청 호스트(http://localhost:3000)를 그대로 사용한다.
BASE_URL=

# 로그인 유지 시간(시간). 기본 12
SESSION_HOURS=12
